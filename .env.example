# Copia questo file in `.env.local` (già ignorato da Git) e compila i valori.
# Se le variabili Supabase sono vuote, l'app parte in MODALITÀ DEMO con dati locali.
#
# Dove trovarle: Supabase → il tuo progetto → Project Settings → API (URL e chiave "publishable").
#
# Nota: le variabili EXPO_PUBLIC_* finiscono nel bundle dell'app e sono quindi pubbliche.
# Usa qui SOLO la chiave pubblica/publishable (pensata per il client, protetta dalle policy RLS).
# NON inserire MAI la chiave segreta / "service_role" o chiavi di provider AI: vanno solo lato server.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# In alternativa, per progetti meno recenti:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
