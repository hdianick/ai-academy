# Copia questo file in `.env.local` (già ignorato da Git) e compila i valori.
# Se le variabili Supabase sono vuote, l'app parte in MODALITÀ DEMO con dati locali.
#
# Nota: le variabili EXPO_PUBLIC_* finiscono nel bundle dell'app e sono quindi pubbliche.
# Usa qui SOLO la "anon key" di Supabase (pensata per il client, protetta dalle policy RLS).
# NON inserire MAI la "service_role key" o chiavi di provider AI: quelle vanno solo lato server
# (es. Supabase Edge Functions).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
